# Agent Management Platform — copy to .env and adjust

# API
API_HOST=0.0.0.0
API_PORT=8081
API_TOKEN=change-me-to-a-long-random-token
CORS_ORIGINS=*
API_PUBLISH_PORT=8081

# Postgres
POSTGRES_USER=amp
POSTGRES_PASSWORD=amp_dev_password
POSTGRES_DB=agent_platform
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://amp:amp_dev_password@postgres:5432/agent_platform

# Execution engine: local | docker
EXECUTION_MODE=docker
DOCKER_NETWORK=agent-management-platform_amp
DEFAULT_AGENT_IMAGE=python:3.12-slim

# Host path to ~/.aws (as seen by the Docker daemon). Mounted read-only into
# agent runs that set permissions.cloud_read (e.g. aws-cost-agent).
# Example: HOST_AWS_DIR=/home/you/.aws
HOST_AWS_DIR=

# LLM via LiteLLM (optional Compose profile: --profile llm)
# Starting with --profile llm also auto-pulls DEFAULT_LLM_MODEL via ollama-init.
# LLM is optional: agents only use it if their code calls context["llm"] / Ollama.
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3
LLM_API_BASE=http://ollama:11434
OLLAMA_PUBLISH_PORT=11435
